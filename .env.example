# Database — Neon PostgreSQL
DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/wahyu_laundry?sslmode=require"

# Auth JWT secret (jose HS256) — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-strong-random-secret-at-least-32-chars-min"
# Fallback for NextAuth compatibility
NEXTAUTH_SECRET="replace-with-strong-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: direct URL for Prisma (if using pooled connection)
# DATABASE_URL_UNPOOLED="postgresql://username:password@ep-xxx.neon.tech/wahyu_laundry?sslmode=require"
